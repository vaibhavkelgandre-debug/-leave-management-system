PORT=5001

NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=leave_management_system
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Set instead of DB_HOST/etc in production (Render/Railway managed Postgres)
DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=lms_token

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
CLIENT_BASE_URL=http://localhost:5173

GOOGLE_CLIENT_ID=783513070491-e36undssm9pr63cv1snabjq0v1s5of23.apps.googleusercontent.com

# GitHub OAuth App credentials (github.com/settings/developers) — callback URL
# must be set there to {CLIENT_BASE_URL}/login/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Shared secret required to self-register as the first/next HR admin
HR_REGISTRATION_CODE=

# Unaccepted invites expire after this many hours, and the pending account is
# then deleted so the email can be re-invited.
INVITE_TOKEN_TTL_HOURS=24

# Cloudinary account (Dashboard -> Product Environment Credentials)
# used for storing leave-request documents (e.g. medical certificates).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
